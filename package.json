    "husky": "^9.1.7",
    "npm-run-all2": "^9.0.3",
    "oxlint": "^1.86.0",
    "release-it": "^21.1.0",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "webdriverio": "^9.32.0"
  }
}
