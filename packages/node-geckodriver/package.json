{
  "name": "geckodriver",
  "version": "7.0.0",
  "description": "Mozilla's Geckodriver for Node.js",
  "homepage": "https://github.com/webdriverio/driver/tree/main/packages/node-geckodriver#readme",
  "license": "MIT",
  "author": {
    "name": "vladikoff",
    "email": "vlad.filippov@gmail.com",
    "url": "http://vf.io"
  },
  "contributors": [
    {
      "name": "Christian Bromann",
      "url": "https://bromann.dev",
      "email": "mail@bromann.dev"
    }
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "geckodriver",
    "webdriver"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webdriverio/driver.git",
    "directory": "packages/node-geckodriver"
  },
  "scripts": {
    "build": "tsc -b . && node ../../scripts/copy-cjs-pkg.mjs",
    "clean": "rimraf ./dist",
    "postinstall": "test -f ./dist/install.js && node ./dist/install.js || echo \"Skipping install, project not built!\"",
    "test": "run-s build test:*",
    "test:lint": "oxlint .",
    "test:unit": "vitest --run",
    "watch": "pnpm run build -- --watch"
  },
  "bin": {
    "geckodriver": "./bin/geckodriver.js"
  },
  "bugs": {
    "url": "https://github.com/webdriverio/driver/issues"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "main": "./dist/cjs/index.js",
  "exports": {
    ".": [
      {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/cjs/index.js"
      },
      "./dist/cjs/index.js"
    ]
  },
  "dependencies": {
    "@wdio/logger": "^9.18.0",
    "@zip.js/zip.js": "^2.18.2",
    "decamelize": "^6.0.1",
    "http-proxy-agent": "^9.1.0",
    "https-proxy-agent": "^9.1.0",
    "modern-tar": "^0.8.5"
  }
}
